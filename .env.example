# ============================================================================
# docker compose 配置模板：复制为 .env 后按需修改
#   cp .env.example .env
# 修改后执行：docker compose up -d
# ============================================================================

# --- 管理面板 ---
PANEL_USERNAME=admin
# 面板登录密码（务必修改！）
PANEL_PASSWORD=admin123
# 会话签名密钥（务必修改！生成：openssl rand -hex 32）
SESSION_SECRET=please-change-me
# 面板端口
PANEL_PORT=3000

# --- TeamSpeak 6 服务器 ---
# 语音 / 文件传输 / WebQuery / SSH Query 端口
TS_PORT_VOICE=9987
TS_PORT_FILE=30033
TS_PORT_WEBQUERY=10080
TS_PORT_SSHQUERY=10022

# 覆盖默认 Query 管理员密码（可选，留空则首次启动自动生成并打印在日志）
# ⚠️ 忘记 serveradmin 密码时：在此设置新密码 → docker compose up -d teamspeak，
#    即可用新密码登录 SSH Query（已验证 override 生效）
TS_QUERY_ADMIN_PASSWORD=

# --- WebQuery API Key（点歌机器人进入 TS 频道必需） ---
# 与点歌机器人共用同一个 Key；二选一填写：
#   1) 在此填写后，面板与点歌机器人自动共用，点歌页只需填“频道”；
#   2) 或留空，启动面板后在「部署管理」页生成并保存（点歌机器人也会读到同一份）。
# 生成方式（在 TS 服务器容器执行，用 serveradmin 密码 SSH 登录后）：
#   ssh serveradmin@<主机> -p 10022  →  use 1  →  apikeyadd scope=manage lifetime=0
TSSERVER_API_KEY=

# --- 点歌机器人（可选） ---
# 面板后端代理点歌服务的地址（容器内指向 music 服务，一般无需修改）
# MUSIC_BASE_URL=http://music:3200
# 网易云 API 内网地址（指向 api-enhanced，一般无需修改）
# NCMAPI_BASE=http://neteasemusic:3000
# 点歌服务监听端口
# MUSIC_BOT_PORT=3200

# --- 点歌机器人 → TeamSpeak 推流（开箱即用，一般无需修改） ---
# 以下均有默认值；点歌页只需填写“让机器人加入的频道”。如需自定义再覆盖：
# TS6MGR_URL=http://backend:3001
# TS6MGR_USER=tsbot
# TS6MGR_PASS=Tsbot123   # 注意：需含大写+数字（ts6-manager 密码复杂度要求）；这也是 :3002 后台登录账号
# TS_HOST=teamspeak
# TS_WEBQUERY_PORT=10080
# 若不填 TS_API_KEY，可设置 TS_QUERY_ADMIN_PASSWORD 让机器人首次自动生成 API Key：
# TS_QUERY_ADMIN_PASSWORD=

# --- 电台音频流对外地址（重要！但可留空自动探测） ---
# ts6-manager 有 SSRF 防护：电台 URL 不能是“解析到内网 IP”的主机名（如 music/teamspeak），
# 否则建电台会报 “resolves to a private IP” 而失败。必须填对 ts6-manager 可达且非内网的地址。
# 默认留空即可：点歌服务启动时自动探测本机公网 IP 并拼成 http://<公网IP>:3200/api/stream。
# 仅当自动探测失败（容器无外网）时才手动设置：STREAM_PUBLIC_HOST=你的公网IP/域名
#   STREAM_PUBLIC_HOST=8.*.*.98
# 或直接在 STREAM_PUBLIC_URL 给完整地址（端口用下面的 MUSIC_STREAM_PORT）：
#   STREAM_PUBLIC_URL=http://8.*.*.98:3200/api/stream
# 电台流监听端口（需在防火墙/安全组放行该端口，ts6-manager 才能拉到流）：
#   MUSIC_STREAM_PORT=3200
# 电台流访问令牌（防公网被随意收听；机器人电台 URL 会自动带上 ?t=）：
#   STREAM_TOKEN=ts6bot

# --- TS 频道聊天点歌 ---
# 设置 TS_QUERY_ADMIN_PASSWORD 后自动启用：面板会以 serveradmin 经 SSH Query(10022)
# 登录一个「点歌助手」客户端加入点歌频道，监听频道聊天。
# 同频道用户发送：!点歌 <歌曲ID> 或 !点歌 <网易云歌曲链接> 即可点歌并收到回执。
# 显式关闭（即使设置了密码）：TS_CHAT_ENABLED=0
# TS_CHAT_ENABLED=

