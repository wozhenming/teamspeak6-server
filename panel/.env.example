# ============================================================
# TeamSpeak 6 管理面板 配置模板
# 复制为 .env 后按需修改：  cp .env.example .env
# ============================================================

# --- 面板自身 ---
# 面板监听地址与端口（WebQuery 端口建议仅监听 127.0.0.1）
HOST=127.0.0.1
PORT=3000

# 面板登录账号（面板自带认证，与 TS6 原生认证无关）
PANEL_USERNAME=admin
PANEL_PASSWORD=admin123

# 会话签名密钥（务必改为随机长字符串！可用: openssl rand -hex 32）
SESSION_SECRET=please-change-me

# --- TeamSpeak 6 WebQuery ---
# WebQuery HTTP API 地址（默认本机 10080 端口）
TSSERVER_BASE_URL=http://127.0.0.1:10080

# WebQuery API Key（必须通过 SSH Query 生成: apikeyadd scope=manage lifetime=0）
TSSERVER_API_KEY=

# 默认管理的虚拟服务器 ID
TSSERVER_DEFAULT_SID=1
